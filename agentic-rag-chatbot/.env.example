# Required
OPENAI_API_KEY=sk-your-openai-api-key

# Models
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector store
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=lilian_weng_kb
TOP_K=4

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# API
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Serper for higher-quality web search (falls back to DuckDuckGo)
SERPER_API_KEY=

# Optional: used by n8n Slack/webhook node (not required by Python API)
SLACK_WEBHOOK_URL=
