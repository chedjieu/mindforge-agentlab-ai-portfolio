# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3
OLLAMA_EMBED_MODEL=nomic-embed-text

# Paths
CHROMA_PATH=./data/chroma
SQLITE_PATH=./data/checkpoints.db
ASSETS_DIR=./assets
STUDY_NOTE_PATH=./data/study_note.md

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=4
MIN_RETRIEVAL_SCORE=0.25

# API
API_HOST=0.0.0.0
API_PORT=8000
MAX_MESSAGE_CHARS=4000

# Optional Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# OpenTelemetry (set to enable OTLP export)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=agentforge
