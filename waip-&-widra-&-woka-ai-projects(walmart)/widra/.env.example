# Copy to .env and fill in. NEVER commit your .env file.
# ---
# OFFLINE / LOCAL DEMO MODE: set WIDRA_MODEL=fake (and optionally WIDRA_EMBEDDINGS=fake)
# ---

# --- AWS ---
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- GCP ---
GCP_PROJECT=meta-cistern-439423-r1
GCP_LOCATION=us-central1
GCP_BUCKET=meta-cistern-439423-r1-widra-staging

# --- Model selection ---
WIDRA_MODEL=bedrock_converse:openai.gpt-oss-120b-1:0
# WIDRA_MODEL=bedrock_converse:openai.gpt-oss-20b-1:0
# WIDRA_MODEL=google_vertexai:gemini-2.5-pro
# WIDRA_MODEL=fake

WIDRA_EMBEDDINGS=bedrock:amazon.titan-embed-text-v2:0
# WIDRA_EMBEDDINGS=google_vertexai:text-embedding-005
# WIDRA_EMBEDDINGS=fake

# --- Tavily ---
TAVILY_API_KEY=

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=widra
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=widra

# --- Postgres (WIDRA compose port 5433) ---
POSTGRES_DSN=postgresql://widra:widra@localhost:5433/widra

# --- Local storage stack ---
WEAVIATE_URL=http://localhost:8081
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=widra-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# PINECONE_API_KEY=
# PINECONE_INDEX=widra-prod

# --- Memory ---
WIDRA_MEMORY=memory

# --- Guardrails ---
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# VERTEX_MODEL_ARMOR_POLICY=
