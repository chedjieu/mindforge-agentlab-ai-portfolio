# Copy to .env and fill in. NEVER commit your .env file.
# ---
# OFFLINE / LOCAL DEMO MODE: set WAIP_MODEL=fake (and optionally WAIP_EMBEDDINGS=fake)
# ---

# --- AWS ---
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- GCP ---
GCP_PROJECT=meta-cistern-439423-r1
GCP_LOCATION=us-central1
GCP_BUCKET=meta-cistern-439423-r1-waip-staging

# --- Model selection ---
WAIP_MODEL=bedrock_converse:openai.gpt-oss-120b-1:0
# WAIP_MODEL=bedrock_converse:openai.gpt-oss-20b-1:0
# WAIP_MODEL=google_vertexai:gemini-2.5-pro
# WAIP_MODEL=fake

WAIP_EMBEDDINGS=bedrock:amazon.titan-embed-text-v2:0
# WAIP_EMBEDDINGS=google_vertexai:text-embedding-005
# WAIP_EMBEDDINGS=fake

# --- Tavily ---
TAVILY_API_KEY=

# --- LangSmith ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=waip
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=waip

# --- Postgres (WAIP compose port 5432) ---
POSTGRES_DSN=postgresql://waip:waip@localhost:5432/waip

# --- Neo4j (optional) ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# --- Memory ---
WAIP_MEMORY=memory

# --- Guardrails ---
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
# VERTEX_MODEL_ARMOR_POLICY=
