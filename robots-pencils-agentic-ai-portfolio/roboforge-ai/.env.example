# roboforge-ai local environment
# Defaults below work offline. Uncomment/fill cloud vars for live Bedrock / Vertex.

# --- Models (offline-friendly defaults) ---
RFAI_MODEL=fake
RFAI_EMBEDDINGS=fake
RFAI_ALLOW_FAKE_FALLBACK=1
# Live answerer (Bedrock):
# RFAI_MODEL=bedrock_converse:openai.gpt-oss-120b-1:0
# Live answerer (Vertex):
# RFAI_MODEL=google_vertexai:gemini-2.5-pro

# --- Local services (optional) ---
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/rfai
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# --- API ---
HOST=127.0.0.1
PORT=8003

# --- AWS / Bedrock (optional) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- GCP / Vertex (optional) ---
# GCP_PROJECT=
# GCP_LOCATION=us-central1

# --- AgentCore / observability (optional) ---
# DISABLE_AGENTCORE_MEMORY=1
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=roboforge-ai
