# Normalize line endings across Windows / macOS / Linux.
# Prevents noisy "LF will be replaced by CRLF" warnings on Windows.
* text=auto eol=lf

# Keep Windows scripts with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Treat binary assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.sqlite binary
*.db binary
