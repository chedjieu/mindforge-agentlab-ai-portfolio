# panasonic-egkp local environment
# Defaults below work offline. Uncomment/fill cloud vars for live Bedrock / Vertex.

# --- Models (offline-friendly defaults) ---
EGKP_MODEL=fake
EGKP_EMBEDDINGS=fake
EGKP_JUDGE_MODEL=fake
# Live answerer (Bedrock):
# EGKP_MODEL=bedrock_converse:openai.gpt-oss-120b-1:0
# EGKP_EMBEDDINGS=bedrock:amazon.titan-embed-text-v2:0
# Live answerer (Vertex):
# EGKP_MODEL=google_vertexai:gemini-2.5-pro
# Cross-provider judge (required for ship gates when not fake):
# EGKP_JUDGE_MODEL=google_vertexai:gemini-2.5-pro
EGKP_ALLOW_FAKE_FALLBACK=1

# --- Retrieval / memory ---
EGKP_VECTORS=chroma
EGKP_CHROMA_DIR=data/chroma
EGKP_MEMORY=memory
GROUNDING_SHIP_THRESHOLD=0.85

# --- Local services (optional) ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5433/egkp
EGKP_NEO4J_URI=bolt://localhost:7687
EGKP_NEO4J_USER=neo4j
EGKP_NEO4J_PASSWORD=password

# --- API ---
HOST=127.0.0.1
PORT=8002

# --- AWS / Bedrock (optional) ---
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# BEDROCK_KB_ID=
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
# For Bedrock KB retrieval: EGKP_VECTORS=bedrock_kb

# --- GCP / Vertex (optional) ---
# GCP_PROJECT=
# GCP_LOCATION=us-central1
# GCP_BUCKET=
# VERTEX_INDEX_ENDPOINT=
# VERTEX_DEPLOYED_INDEX_ID=
# For Vertex Vector Search: EGKP_VECTORS=vertex

# --- AgentCore ---
DISABLE_AGENTCORE_MEMORY=1

# --- Observability / alerts (optional) ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=panasonic-egkp
# SLACK_BOT_TOKEN=
# ALERT_EMAIL=
