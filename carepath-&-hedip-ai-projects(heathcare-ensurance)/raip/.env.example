# RAIP local configuration. Copy to .env — never commit secrets.
# No production PHI. Synthetic data only.

RAIP_ENV=local
RAIP_PORT=8011
RAIP_LOG_LEVEL=INFO

# Models: fake | bedrock_converse:<id> | google_vertexai:<id>
RAIP_MODEL=fake
RAIP_JUDGE_MODEL=fake
RAIP_EMBEDDINGS=fake
RAIP_RERANKER=heuristic

# SQLite default (no Docker). Postgres example:
# RAIP_DATABASE_URL=postgresql+psycopg2://raip:raip@localhost:5432/raip
RAIP_DATABASE_URL=sqlite:///./data/raip.sqlite

# Optional GraphRAG. Unset = JSONL in-memory graph.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=changeme

# LangGraph checkpointer: memory | sqlite | postgres
RAIP_MEMORY=memory
# POSTGRES_DSN=postgresql://raip:raip@localhost:5432/raip

# HITL: required (demo) | evaluate (evals skip interrupt)
RAIP_HITL=required

# Auth (local). Production: OIDC. Never ship real credentials.
RAIP_DEMO_TENANT=tenant-northstar
RAIP_DEMO_USER=author-01
RAIP_DEMO_ROLE=AUTHOR

# Object store
RAIP_OBJECT_ROOT=./data/objects

# Cost rates (USD / 1K tokens) — estimates only
RAIP_COST_INPUT_PER_1K=0.003
RAIP_COST_OUTPUT_PER_1K=0.015

# Quality gate thresholds
RAIP_GROUNDING_MIN=0.95
RAIP_CITATION_MIN=0.95
RAIP_UNSUPPORTED_MAX=0.01
RAIP_INJECTION_MIN=0.95

# Optional cloud
# AWS_REGION=us-east-1
# GCP_PROJECT=
# GCP_LOCATION=us-central1
