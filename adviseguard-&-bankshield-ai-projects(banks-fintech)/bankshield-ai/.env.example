# bankshield-ai local environment
# Defaults below work offline. Uncomment/fill cloud vars for live Bedrock / Vertex.

# --- Models (offline-friendly defaults) ---
BANKSHIELD_MODEL=fake
BANKSHIELD_EMBEDDINGS=fake
BANKSHIELD_JUDGE_MODEL=fake
# Live answerer (Bedrock):
# BANKSHIELD_MODEL=bedrock_converse:anthropic.claude-sonnet-4-20250514-v1:0
# BANKSHIELD_EMBEDDINGS=bedrock:amazon.titan-embed-text-v2:0
# Live answerer (Vertex):
# BANKSHIELD_MODEL=google_vertexai:gemini-2.5-pro
# Cross-provider judge (required for ship gates when not fake):
# BANKSHIELD_JUDGE_MODEL=google_vertexai:gemini-2.5-pro
BANKSHIELD_ALLOW_FAKE_FALLBACK=1

# --- Retrieval / memory ---
BANKSHIELD_VECTORS=chroma
BANKSHIELD_CHROMA_DIR=data/chroma
BANKSHIELD_MEMORY=memory
GROUNDING_SHIP_THRESHOLD=0.85

# --- Local services (optional) ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5434/bankshield
BANKSHIELD_NEO4J_URI=bolt://localhost:7687
BANKSHIELD_NEO4J_USER=neo4j
BANKSHIELD_NEO4J_PASSWORD=password

# --- API ---
HOST=127.0.0.1
PORT=8003

# --- AWS / Bedrock (optional) ---
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=
# BEDROCK_KB_ID=
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- GCP / Vertex (optional) ---
# GCP_PROJECT=
# GCP_LOCATION=us-central1
# GCP_BUCKET=

# --- AgentCore ---
DISABLE_AGENTCORE_MEMORY=1

# --- Observability (optional) ---
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=bankshield-ai
